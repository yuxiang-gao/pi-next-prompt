{
  "name": "pi-next-prompt",
  "version": "0.2.0",
  "description": "Editable next-message suggestions for Pi with file-based configuration and optional System One routing",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuxiang-gao/pi-next-prompt.git"
  },
  "homepage": "https://github.com/yuxiang-gao/pi-next-prompt#readme",
  "bugs": {
    "url": "https://github.com/yuxiang-gao/pi-next-prompt/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "prompt-suggestions",
    "system-one",
    "jev"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src/",
    "examples/",
    "assets/",
    "docs/configuration.md",
    "docs/debugging.md",
    "docs/development.md",
    "docs/adr/",
    "CONTEXT.md",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "image": "assets/banner.png"
  },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0"
  }
}
